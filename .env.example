# ─────────────────────────────────────────────────────────────────────────────
# Tarot Journal — environment variables
# Copy to .env.local for local development. Never commit real secrets.
# Validated at startup by src/config/env.ts — a missing required var fails loudly.
# Values below match a local `pnpm supabase:start` on this repo's ports.
# ─────────────────────────────────────────────────────────────────────────────

# ── Public (shipped to the browser; NEXT_PUBLIC_ prefix required) ────────────
# Environment label used for flags/telemetry. development | preview | production
NEXT_PUBLIC_APP_ENV=development
# Supabase project URL (local: http://127.0.0.1:55321)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
# Supabase anon key (RLS-respecting). Either the legacy JWT anon key or the new
# `sb_publishable_…` key works. Get it from `pnpm supabase:status`.
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key
# Optional Sentry DSN for the browser. Leave empty to disable.
NEXT_PUBLIC_SENTRY_DSN=

# ── Server only (never exposed to the client; lint forbids importing serverEnv
#    from a 'use client' file) ────────────────────────────────────────────────
# Direct Postgres connection used by Drizzle migrations, the job worker and admin
# queries. Bypasses RLS — only src/db/admin/ may use it.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres
# Supabase service-role key (bypasses RLS). Only src/db/admin/ may use it.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
# Shared secret for POST /api/jobs/run (Vercel cron and `pnpm jobs:run`).
JOBS_RUN_SECRET=change-me-to-a-long-random-string
# Server-side Sentry DSN. Leave empty to disable.
SENTRY_DSN=

# ── AI (all calls run server-side through src/ai/) ──────────────────────────
# mock | anthropic  — `mock` is the only provider until Phase 04.
AI_PROVIDER=mock
# Provider keys. Only required when AI_PROVIDER=anthropic (Phase 04+).
ANTHROPIC_API_KEY=
# Embeddings provider key (Phase 09). Only the sanitised retrieval document is sent.
OPENAI_API_KEY=
# Model routing: task tier → concrete model ID. Change here, never in business code.
AI_MODEL_FAST=claude-haiku-4-5
AI_MODEL_STANDARD=claude-sonnet-5
AI_MODEL_DEEP=claude-opus-5
AI_EMBEDDING_MODEL=text-embedding-3-small

# ── Feature flags (env defaults; per-user overrides land in Phase 01) ───────
# Each is `true` or `false`. Default off in production until the phase's evals pass.
FLAG_AI_EXTRACTION=false
FLAG_ENTITY_RESOLUTION=false
FLAG_JOURNEY_AUTOCREATE=false
FLAG_CORRELATION_SUGGESTIONS=false
FLAG_ASK_MY_HISTORY=false
FLAG_PERIOD_SUMMARIES=false
FLAG_SHARE_CARDS=false
FLAG_PHYSICAL_PHOTO_OCR=false
