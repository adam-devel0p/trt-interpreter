{
  "name": "tarot-journal",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.2.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status -o env",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:generate": "drizzle-kit generate",
    "db:seed": "tsx --conditions=react-server scripts/seed-reference.ts",
    "demo:seed": "tsx --conditions=react-server scripts/seed-demo.ts",
    "jobs:run": "tsx --conditions=react-server scripts/jobs-run.ts",
    "test": "vitest run --config vitest.config.ts && vitest run --config vitest.integration.config.ts",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:rls": "vitest run --config vitest.rls.config.ts",
    "test:e2e": "playwright test",
    "eval": "tsx --conditions=react-server scripts/eval.ts",
    "lint": "eslint . && prettier --check . && tsx scripts/check-deletion-registry.ts",
    "lint:fix": "eslint . --fix && prettier --write .",
    "typecheck": "tsc --noEmit",
    "check:prompt-versions": "tsx scripts/check-prompt-versions.ts",
    "check:client-bundle": "tsx scripts/check-client-bundle.ts",
    "icons:generate": "tsx scripts/gen-icons.ts",
    "art:build": "tsx scripts/build-card-art.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@sentry/nextjs": "^10.74.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "fflate": "^0.8.3",
    "framer-motion": "^13.2.0",
    "next": "^15.5.25",
    "postgres": "^3.4.9",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.25",
    "expect-type": "^1.4.0",
    "postcss": "^8.5.28",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  }
}
